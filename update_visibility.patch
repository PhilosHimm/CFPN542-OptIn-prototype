+export async function updateGameVisibility(gameId: string, visibility: "Public" | "Group Only" | "Private"): Promise<{ error: string | null }> {
+  if (USE_MOCK_DATA) {
+    const game = DEMO_GAMES.find((g) => g.id === gameId);
+    if (game) game.visibility = visibility;
+    return { error: null };
+  }
+  
+  const { error } = await supabase
+    .from("games")
+    .update({ visibility })
+    .eq("id", gameId);
+    
+  if (error) {
+    console.error("Error updating game visibility:", error);
+    return { error: error.message };
+  }
+  
+  return { error: null };
+}
